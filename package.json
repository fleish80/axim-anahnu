{
  "name": "axim-anahnu",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node -e \"require('node:fs').copyFileSync('dist/axim-anahnu/browser/404/index.html', 'dist/axim-anahnu/browser/404.html')\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:hosting": "npm run build && npx -y firebase-tools@latest deploy --only hosting",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules",
    "og-images": "node scripts/og-images.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
